generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTH ====================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  document      String   @unique
  role          String   @default("EMPLEADO") // EMPLEADO, AUXILIAR_GH, GERENCIA, CONTABILIDAD, ABOGADO, ADMIN
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee?
  notifications Notification[]
  auditLogs     AuditLog[]
  historial     HistorialEstado[]
  seguimientos  Seguimiento[]
}

model Employee {
  id           String   @id @default(cuid())
  userId       String   @unique
  document     String   @unique
  name         String
  email        String
  phone        String?
  area         String
  cargo        String
  salary       Float    // IBC base
  epsId        String
  arlId        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                User              @relation(fields: [userId], references: [id])
  eps                 EPS               @relation(fields: [epsId], references: [id])
  arl                 ARL?              @relation(fields: [arlId], references: [id])
  incapacidades       Incapacidad[]
  documentosFisicos   DocumentoFisico[]
}

// ==================== ENTITIES ====================

model EPS {
  id                String   @id @default(cuid())
  nombre            String   @unique
  nit               String   @unique
  portalWeb         String?
  portalDigital     Boolean  @default(true)
  diasTranscripcion Int      @default(30)
  tiempoRespuesta   Int      @default(15) // días
  contacto          String?
  email             String?
  activa            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  empleados      Employee[]
  incapacidades  Incapacidad[]
  lotesCobro     LoteCobro[]
}

model ARL {
  id        String   @id @default(cuid())
  nombre    String   @unique
  nit       String   @unique
  contacto  String?
  email     String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empleados Employee[]
}

// ==================== INCAPACIDADES ====================

model Incapacidad {
  id                String   @id @default(cuid())
  radicado          String   @unique
  empleadoId        String
  epsId             String
  tipoNovedad       String   // ENFERMEDAD_COMUN, ACCIDENTE_TRANSITO, ACCIDENTE_TRABAJO, LICENCIA_MATERNIDAD, LICENCIA_PATERNIDAD, PRORROGA
  estado            String   @default("RECIBIDA") // RECIBIDA, PENDIENTE_VALIDACION, VALIDADA, PENDIENTE_SUBSANACION, SUBSANACION_VENCIDA, TRANSCRITA, RECHAZADA_ENTIDAD, EN_COBRO, COBRO_PERSUASIVO, COBRO_JURIDICO, GLOSA, PAGADA, TRAMITE_PENSION, ARCHIVADA
  fechaInicio       DateTime
  fechaFin          DateTime
  diasIncapacidad   Int
  diasAcumulados    Int      @default(0)
  diagnosticoCIE10  String?
  descripcionCIE10  String?
  esReporteExtemporaneo Boolean @default(false)
  esProrroga        Boolean  @default(false)
  incapacidadOriginalId String? // para prórrogas
  fechaRegistro     DateTime @default(now())
  fechaValidacion   DateTime?
  fechaTranscripcion DateTime?
  fechaCobro        DateTime?
  fechaPago         DateTime?
  fechaArchivo      DateTime?
  observaciones     String?
  valorCobro        Float?
  valorPagado       Float?
  valorEmpleador    Float?
  valorEPS          Float?
  diasEmpleador     Int       @default(2)
  fechaAceptacionEPS DateTime?
  referenciaPagoEPS String?
  numeroRadicadoEPS String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  empleado           Employee          @relation(fields: [empleadoId], references: [id])
  eps                EPS               @relation(fields: [epsId], references: [id])
  incapacidadOriginal Incapacidad?     @relation("Prorrogas", fields: [incapacidadOriginalId], references: [id])
  prorrogas          Incapacidad[]     @relation("Prorrogas")
  documentos         Documento[]
  documentosFisicos  DocumentoFisico[]
  historial          HistorialEstado[]
  seguimientos       Seguimiento[]
  cobros             DetalleCobro[]
  subsanaciones      Subsanacion[]
  rechazos           RechazoEPS[]
  cobroJuridico      CobroJuridico?
  reintegro          Reintegro?
  archivo            Archivo?
  derechosPeticion   DerechoPeticion[]
  evidenciasRadicacion EvidenciaRadicacion[]
  rehabilitaciones  Rehabilitacion[]
}

// ==================== DOCUMENTOS ====================

model Documento {
  id              String   @id @default(cuid())
  incapacidadId   String
  tipoDocumento   String   // CERTIFICADO_ORIGINAL, EPICRISIS, FURIPS, CERTIFICADO_NACIDO_VIVO, REGISTRO_CIVIL, DOCUMENTO_IDENTIDAD, CERTIFICADO_MEDICO, SOPORTE_RADICACION, OTRO
  nombreArchivo   String
  rutaArchivo     String
  formato         String   // PDF, JPG, PNG
  pesoKB          Int
  obligatorio     Boolean  @default(true)
  aprobado        Boolean?
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
}

model DocumentoFisico {
  id              String   @id @default(cuid())
  empleadoId      String
  incapacidadId   String?
  tipoDocumento   String
  recibido        Boolean  @default(false)
  fechaRecepcion  DateTime?
  recibidoPor     String?
  observaciones   String?
  createdAt       DateTime @default(now())

  empleado    Employee     @relation(fields: [empleadoId], references: [id])
  incapacidad Incapacidad? @relation(fields: [incapacidadId], references: [id])
}

// ==================== HISTORIAL Y TRAZABILIDAD ====================

model HistorialEstado {
  id              String   @id @default(cuid())
  incapacidadId   String
  estadoAnterior  String?
  estadoNuevo     String
  accion          String
  usuarioId       String?
  observaciones   String?
  fecha           DateTime @default(now())

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
  usuario     User?       @relation(fields: [usuarioId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  accion    String
  modulo    String
  detalle   String?
  createdAt DateTime @default(now())

  usuario User? @relation(fields: [userId], references: [id])
}

// ==================== SEGUIMIENTO ====================

model Seguimiento {
  id              String   @id @default(cuid())
  incapacidadId   String
  usuarioId       String?
  tipoAlerta      String?  // VERDE, AMARILLO, ROJO
  accion          String
  observaciones   String?
  fechaGestion    DateTime @default(now())

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
  usuario     User?       @relation(fields: [usuarioId], references: [id])
}

// ==================== SUBSANACION ====================

model Subsanacion {
  id              String   @id @default(cuid())
  incapacidadId   String
  fechaSolicitud  DateTime @default(now())
  fechaLimite     DateTime
  fechaRespuesta  DateTime?
  estado          String   @default("PENDIENTE") // PENDIENTE, SUBSANADA, VENCIDA, SEGUNDO_AVISO
  documentosFaltantes String
  observaciones   String?
  recordatoriosEnviados Int @default(0)
  tipo            String   @default("PRIMERO") // PRIMERO, SEGUNDO
  citatorioEnviado Boolean  @default(false)

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
}

// ==================== COBROS ====================

model LoteCobro {
  id            String   @id @default(cuid())
  numeroLote    String   @unique
  epsId         String
  estado        String   @default("GENERADO") // GENERADO, ENVIADO, PAGADO_PARCIAL, PAGADO_TOTAL, RECHAZADO
  valorTotal    Float
  fechaGeneracion DateTime @default(now())
  fechaEnvio    DateTime?
  observaciones String?

  eps       EPS            @relation(fields: [epsId], references: [id])
  detalles  DetalleCobro[]
}

model DetalleCobro {
  id              String   @id @default(cuid())
  loteCobroId     String
  incapacidadId   String
  valorEsperado   Float
  valorPagado     Float?
  estado          String   @default("PENDIENTE") // PENDIENTE, PAGADO, GLOSA, DIFERENCIA
  fechaPago       DateTime?
  comprobante     String?
  observaciones   String?

  loteCobro     LoteCobro    @relation(fields: [loteCobroId], references: [id])
incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
}

// ==================== EVIDENCIA RADICACION ====================

model EvidenciaRadicacion {
  id                String   @id @default(cuid())
  incapacidadId     String
  metodoRadicacion  String   // PORTAL_WEB, CORREO, FISICO
  numeroRadicadoEPS String?
  soporteUrl        String?
  portalUrl         String?
  fechaRadicacion   DateTime @default(now())
  observaciones     String?
  radicadoPor       String?
  createdAt         DateTime @default(now())

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
}

// ==================== REHABILITACION ====================

model Rehabilitacion {
  id                      String   @id @default(cuid())
  incapacidadId           String   @unique
  conceptoSolicitado      Boolean  @default(false)
  fechaSolicitudConcepto  DateTime?
  conceptoFavorable       Boolean?
  conceptoRecibido        DateTime?
  notificadoEPS           Boolean  @default(false)
  notificadoARL           Boolean  @default(false)
  notificadoAFP           Boolean  @default(false)
  notificadoTrabajador    Boolean  @default(false)
  observaciones           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
}

// ==================== RECHAZOS ====================

model RechazoEPS {
  id              String   @id @default(cuid())
  incapacidadId   String
  causal          String   // DOCUMENTAL, DE_FORMA, DE_FONDO
  descripcion     String
  fechaRechazo    DateTime @default(now())
  documentoEPS    String?
  esSubsanable    Boolean
  gestionado      Boolean  @default(false)
  fechaGestion    DateTime?
  observaciones   String?

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
}

// ==================== COBRO JURÍDICO ====================

model CobroJuridico {
  id              String   @id @default(cuid())
  incapacidadId   String   @unique
  abogadoId       String?
  estado          String   @default("ASIGNADO") // ASIGNADO, DERECHO_PETICION, TUTELA, DEMANDA, FALLO_FAVORABLE, FALLO_DEFAVORABLE, CONCILIACION, CERRADO
  analisisLegal   String?
  estrategia      String?
  radicadoDP      String?
  fechaRadicadoDP DateTime?
  resultado       String?
  fechaResultado  DateTime?
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
}

// ==================== REINTEGRO ====================

model Reintegro {
  id              String   @id @default(cuid())
  incapacidadId   String   @unique
  montoRecibido   Float
  montoReintegro  Float
  estado          String   @default("PENDIENTE") // PENDIENTE, GESTIONADO, CERRADO
  fechaNotificacionEmpleado DateTime?
  fechaCierre     DateTime?
  observaciones   String?
  createdAt       DateTime @default(now())

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
}

// ==================== ARCHIVO ====================

model Archivo {
  id                String   @id @default(cuid())
  incapacidadId     String   @unique
  fechaArchivo      DateTime @default(now())
  documentacionCompleta Boolean @default(true)
  actaArchivo       String?
  documentosEliminar String?
  estado            String   @default("PENDIENTE") // PENDIENTE, EN_GESTION, ENVIADO, COMPLETADO
  enviadoPor        String?
  fechaEnvioGestionDocumental DateTime?
  historiaClinicaDestruida Boolean @default(false)
  observaciones     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
}

// ==================== PARÁMETROS ====================

model Parametro {
  id          String   @id @default(cuid())
  categoria   String   // LEGALES, ENTIDADES, TIEMPOS, COBRO
  nombre      String
  valor       String
  descripcion String?
  fechaVigencia DateTime @default(now())
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== NOTIFICACIONES ====================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  tipo        String   // ESTADO_CHANGE, RECORDATORIO, ALERTA, SISTEMA
  titulo      String
  mensaje     String
  leida       Boolean  @default(false)
  enlace      String?
  createdAt   DateTime @default(now())

  usuario User @relation(fields: [userId], references: [id])
}

// ==================== DERECHO DE PETICIÓN ====================

model DerechoPeticion {
  id              String   @id @default(cuid())
  incapacidadId   String
  tipo            String   // FALTA_PAGO, GLOSA_INJUSTIFICADA, FALTA_RESPUESTA
  radicado        String?
  contenido       String
  fechaRadicado   DateTime?
  respuesta       String?
  fechaRespuesta  DateTime?
  estado          String   @default("BORRADOR") // BORRADOR, RADICADO, RESPONDIDO, FAVORABLE, DESFAVORABLE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id])
}
